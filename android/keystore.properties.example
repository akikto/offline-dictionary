# Copy to keystore.properties after placing the Play upload keystore.
# Or run: node scripts/setup-android-signing.mjs ./signing.keystore
#
# PWABuilder / AI Studio defaults (from signing-key-info.txt):
#   alias: my-key-alias
#   store + key password: (see your signing-key-info.txt)
#
# Expected Play upload SHA1:
#   24:7A:A9:16:C7:B3:60:7F:66:59:84:B8:84:4F:06:19:A0:B9:EA:0A
RELEASE_STORE_FILE=android.keystore
RELEASE_STORE_PASSWORD=YOUR_KEYSTORE_PASSWORD
RELEASE_KEY_ALIAS=my-key-alias
RELEASE_KEY_PASSWORD=YOUR_KEY_PASSWORD
